# ══════════════════════════════════════════════════════════════════
#  MẪU BIẾN MÔI TRƯỜNG — copy sang .env rồi điền
#      cp .env.example .env
#  .env đã nằm trong .gitignore. KHÔNG BAO GIỜ commit .env thật.
# ══════════════════════════════════════════════════════════════════

# ── Binance ───────────────────────────────────────────────────────
# M1/M2 chỉ dùng public API — KHÔNG cần key. Để trống cũng chạy được.
# Chỉ điền khi tới M13 (paper trade) / M14 (live).
# ⚠️ GATE 4: bật quyền GIAO DỊCH, TẮT quyền RÚT TIỀN, khoá theo IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet dùng cặp key riêng (lấy ở https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── Chế độ giao dịch ─────────────────────────────────────────────
# paper | testnet | live
# RULE 9 + GATE 4: mọi lần khởi động lại đều phải bắt đầu ở "paper".
TRADING_MODE=paper
# Công tắc tổng. Phải là "true" (chữ thường) thì executor mới chạy.
TRADING_ENABLED=false

# ── Telegram (M12) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Hạ tầng ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=file:./mlruns
DATA_DIR=./data
LOG_LEVEL=INFO
